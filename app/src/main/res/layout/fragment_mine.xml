<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- 顶部蓝色背景墙 -->
    <View
        android:id="@+id/vHeader"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 登录区域 -->
    <LinearLayout
        android:id="@+id/llUserInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="点击登录"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/tvCoinInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="登录后解锁更多功能"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 功能列表卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/llUserInfo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 收藏项 -->
            <TextView
                android:id="@+id/tvMyCollect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="我的收藏"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                app:drawableStartCompat="@android:drawable/ic_menu_save"
                app:drawableTint="@color/colorTextSecondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/colorDivider" />

            <!-- 历史项 -->
            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="浏览历史"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                app:drawableStartCompat="@android:drawable/ic_menu_recent_history"
                app:drawableTint="@color/colorTextSecondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/colorDivider" />

            <!-- 设置项 -->
            <TextView
                android:id="@+id/tvSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="系统设置"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                app:drawableStartCompat="@android:drawable/ic_menu_preferences"
                app:drawableTint="@color/colorTextSecondary" />
            <!-- 退出登录项 -->
            <View
                android:id="@+id/vLogoutDivider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/colorDivider"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="退出登录"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                app:drawableStartCompat="@android:drawable/ic_menu_close_clear_cancel"
                app:drawableTint="@color/colorTextSecondary"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>